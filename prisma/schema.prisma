generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CEO
  PROJECT_MANAGER
  EDITOR
  CLIENT
  ACCOUNTANT
  SALES
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  REVISION
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String
  firstName       String
  lastName        String
  role            Role      @default(CLIENT)
  avatar          String?
  phone           String?
  company         String?
  address         String?
  isActive        Boolean   @default(true)
  emailVerified   DateTime?
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  orders          Order[]   @relation("ClientOrders")
  assignedOrders  Order[]   @relation("AssignedOrders")
  sentMessages    Message[] @relation("SentMessages")
  conversations   ConversationParticipant[]
  invoices        Invoice[]
  activities      ActivityLog[]
  notifications   Notification[]
  payments        Payment[]
  savedCards      SavedCard[]
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  clientId      String
  assignedToId  String?
  managerId     String?
  projectName   String
  serviceType   String
  description   String?
  status        OrderStatus @default(PENDING)
  priority      Priority    @default(MEDIUM)
  totalAmount   Decimal     @db.Decimal(10,2)
  paidAmount    Decimal     @default(0) @db.Decimal(10,2)
  deadline      DateTime?
  completedAt   DateTime?
  notes         String?
  revisionCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  client        User        @relation("ClientOrders", fields: [clientId], references: [id])
  assignedTo    User?       @relation("AssignedOrders", fields: [assignedToId], references: [id])
  items         OrderItem[]
  files         OrderFile[]
  invoice       Invoice?
  timeline      OrderTimeline[]
  customizations OrderCustomization[]
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  name        String
  description String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10,2)
  total       Decimal  @db.Decimal(10,2)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderCustomization {
  id           String  @id @default(cuid())
  orderId      String
  optionName   String
  optionValue  String
  priceAdjust  Decimal @default(0) @db.Decimal(10,2)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderFile {
  id          String   @id @default(cuid())
  orderId     String
  fileName    String
  fileUrl     String
  fileType    String
  mimeType    String
  fileSize    BigInt
  uploadedBy  String?
  uploadedAt  DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderTimeline {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  description String
  createdBy   String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String        @unique
  clientId      String
  subtotal      Decimal       @db.Decimal(10,2)
  taxRate       Decimal       @default(0) @db.Decimal(5,2)
  taxAmount     Decimal       @default(0) @db.Decimal(10,2)
  discount      Decimal       @default(0) @db.Decimal(10,2)
  total         Decimal       @db.Decimal(10,2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  paidAt        DateTime?
  notes         String?
  paymentMethod String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  order         Order         @relation(fields: [orderId], references: [id])
  client        User          @relation(fields: [clientId], references: [id])
  payments      Payment[]
  paymentLinks  PaymentLink[]
}

model Conversation {
  id           String    @id @default(cuid())
  name         String?
  isGroup      Boolean   @default(false)
  orderId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  attachments    String[]
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id])
  
  @@index([entityType, entityId])
}

model ServiceCatalog {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10,2)
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  UPI
  NET_BANKING
  PAYPAL
  CRYPTO
  BANK_TRANSFER
  WALLET
  EMI
  CASH
}

enum PaymentGateway {
  STRIPE
  PAYPAL
  RAZORPAY
  COINBASE
  MANUAL
}

enum Currency {
  USD
  EUR
  GBP
  INR
  AED
  SGD
  AUD
  CAD
}

model Payment {
  id                String          @id @default(cuid())
  paymentNumber     String          @unique
  invoiceId         String
  clientId          String
  
  amount            Decimal         @db.Decimal(10,2)
  currency          Currency        @default(USD)
  exchangeRate      Decimal?        @db.Decimal(10,6)
  amountInUSD       Decimal?        @db.Decimal(10,2)
  
  method            PaymentMethod
  gateway           PaymentGateway
  status            PaymentStatus   @default(PENDING)
  
  // Gateway specific IDs
  stripePaymentId   String?
  stripeIntentId    String?
  paypalOrderId     String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  cryptoTxHash      String?
  
  // Card details (masked)
  cardLast4         String?
  cardBrand         String?
  cardExpiry        String?
  
  // Bank details
  bankName          String?
  accountLast4      String?
  ifscCode          String?
  
  // UPI
  upiId             String?
  upiTransactionId  String?
  
  // Crypto
  cryptoCurrency    String?
  cryptoAmount      Decimal?        @db.Decimal(18,8)
  walletAddress     String?
  
  // EMI
  emiMonths         Int?
  emiAmount         Decimal?        @db.Decimal(10,2)
  emiInterestRate   Decimal?        @db.Decimal(5,2)
  
  // Fees
  processingFee     Decimal         @default(0) @db.Decimal(10,2)
  gatewayFee        Decimal         @default(0) @db.Decimal(10,2)
  taxOnFee          Decimal         @default(0) @db.Decimal(10,2)
  
  // Refund
  refundAmount      Decimal?        @db.Decimal(10,2)
  refundReason      String?
  refundedAt        DateTime?
  
  failureReason     String?
  failureCode       String?
  
  metadata          Json?
  notes             String?
  ipAddress         String?
  userAgent         String?
  
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  invoice           Invoice         @relation(fields: [invoiceId], references: [id])
  client            User            @relation(fields: [clientId], references: [id])
  receipt           PaymentReceipt?
  
  @@index([invoiceId])
  @@index([clientId])
  @@index([status])
}

model PaymentReceipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  paymentId     String   @unique
  receiptUrl    String?
  emailSentAt   DateTime?
  createdAt     DateTime @default(now())
  
  payment       Payment  @relation(fields: [paymentId], references: [id])
}

model SavedCard {
  id              String   @id @default(cuid())
  clientId        String
  stripeCardId    String
  last4           String
  brand           String
  expMonth        Int
  expYear         Int
  holderName      String
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  client          User     @relation(fields: [clientId], references: [id])
}

model PaymentLink {
  id          String        @id @default(cuid())
  invoiceId   String
  token       String        @unique
  expiresAt   DateTime
  isUsed      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  
  invoice     Invoice       @relation(fields: [invoiceId], references: [id])
}

model Refund {
  id              String    @id @default(cuid())
  paymentId       String
  amount          Decimal   @db.Decimal(10,2)
  reason          String
  status          String
  gatewayRefundId String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
}

